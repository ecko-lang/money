# money - currency amounts that do not lose cents.
#
#   import money
#
#   price = money.parse("19.99", "USD")
#   total = money.add(price, money.mul(price, 2))
#   money.split(total, 3)        # three parts that sum back exactly
#   money.to_string(total)       # "59.97 USD"
#
# Two rules the whole package exists to enforce.
#
# Amounts are Decimal, never float. `0.10 + 0.20` is exactly `0.30` here; in
# binary floating point it is not, and a cent lost per transaction is a ledger
# that stops balancing.
#
# Division hands out the remainder rather than rounding it away. Splitting
# $0.10 three ways gives 0.04, 0.03, 0.03 - not three of 0.033. The parts of a
# split always sum back to what you started with, which is the property every
# invoice, refund and revenue share depends on.
#
# Pure computation - no capabilities. No exchange rates: converting currencies
# needs a rate from somewhere, and somewhere is not a pure package.

import std.fmt

## The error raised for a bad currency, a currency mismatch, or an impossible
## division.
fn fail(message) {
    error({ kind: "money", message: message })
}

# --- currencies ---------------------------------------------------------------

## Every active ISO 4217 currency and its number of decimal places. Assuming
## two for a code this does not know was the classic bug it replaced: it makes
## yen a hundred times too small and Kuwaiti dinar ten times too large, and it
## quietly accepted a code that is not a currency at all. Built once, here, not
## on every lookup.
MINOR_UNITS = {
    AED: 2,
    AFN: 2,
    ALL: 2,
    AMD: 2,
    ANG: 2,
