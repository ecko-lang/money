## The ISO 4217 table: currency code -> decimal places.
export fn minor_unit_table() = MINOR_UNITS

## How many decimal places this currency uses. A code that is not an active
## ISO 4217 currency is refused rather than guessed at.
export fn minor_units(code) {
    c = normalize_code(code)
    found = get(MINOR_UNITS, c)
    if is_null(found) { fail("'{c}' is not an ISO 4217 currency code") }
    found
}

## Uppercase a currency code and check its shape.
export fn normalize_code(code) {
    up = upper(string(code))
    unless len(chars(up)) == 3 { fail("a currency code must be three letters, got '{code}'") }
    unless all(chars(up), fn(c) c >= "A" and c <= "Z") {
        fail("a currency code must be letters only, got '{code}'")
    }
    up
}

# --- construction --------------------------------------------------------------

## An amount from a Decimal and a currency code. An amount with more decimal
## places than the currency has (`12.345` USD) is refused, because keeping it
## would round it later, out of sight; pass `rounding: true` to round it here,
## half away from zero.
export fn of(amount, code, rounding = false) {
    c = normalize_code(code)
    places = minor_units(c)
    scale = decimal(pow(10, places))
    units = decimal(amount) * scale
    whole = decimal(round(units))
    if units == whole {
        { amount: decimal(amount), currency: c }
    } else if rounding {
        { amount: whole / scale, currency: c }
    } else {
        fail(
            "{amount} has more decimal places than {c} allows ({places}) - pass rounding: true to round it",
        )
    }
}

## An amount from a string: `parse("19.99", "USD")`. Refused, like `of`, when it
## has more decimal places than the currency; `rounding: true` rounds it.
export fn parse(text, code, rounding = false) {
    of(decimal(string(text)), code, rounding: rounding)
}

## Zero in the given currency.
export fn zero(code) = of(decimal(0), code)

## The amount as an integer count of minor units: 10.50 USD -> 1050.
export fn to_minor(m) {
    # `round` on a Decimal is exact and takes halves away from zero, which is
    # what money wants; it never routes through a float.
    round(m.amount * decimal(pow(10, minor_units(m.currency))))
}

## An amount from a count of minor units: 1050 with USD -> 10.50.
export fn from_minor(units, code) {
    normalized = normalize_code(code)
    of(decimal(units) / decimal(pow(10, minor_units(normalized))), normalized)
}

# --- arithmetic ---------------------------------------------------------------

## Both operands must be the same currency. Adding dollars to euros is not a
## rounding question, it is a missing exchange rate, so it fails.
fn same_currency(a, b, what) {
    unless a.currency == b.currency { fail("cannot {what} {a.currency} and {b.currency}") }
}

## a + b.
export fn add(a, b) {
    same_currency(a, b, "add")
    { amount: a.amount + b.amount, currency: a.currency }
}

## a - b.
export fn sub(a, b) {
    same_currency(a, b, "subtract")
    { amount: a.amount - b.amount, currency: a.currency }
}

## An amount scaled by a plain number.
export fn mul(m, factor) {
    { amount: m.amount * decimal(factor), currency: m.currency }
}

## The amount negated.
export fn neg(m) = { amount: decimal(0) - m.amount, currency: m.currency }

## The amount without its sign.
export fn abs_of(m) = if m.amount < decimal(0) { neg(m) } else { m }

## The total of a list. `code` gives the currency for the empty case, where
## there is nothing to infer it from.
export fn sum(items, code) {
    mut total = zero(code)
    for item in items {
        total = add(total, item)
    }
    total
}

# --- comparison ----------------------------------------------------------------

## -1, 0 or 1. Both must be the same currency.
export fn compare(a, b) {
    same_currency(a, b, "compare")
    if a.amount < b.amount { return -1 }
    if a.amount > b.amount { return 1 }
    0
}

## a == b.
export fn eq(a, b) = compare(a, b) == 0

## a < b.
export fn lt(a, b) = compare(a, b) < 0

## a > b.
export fn gt(a, b) = compare(a, b) > 0

## Is the amount exactly zero?
export fn is_zero(m) = m.amount == decimal(0)

## Is the amount below zero?
export fn is_negative(m) = m.amount < decimal(0)

# --- allocation ----------------------------------------------------------------

## Split into `n` parts that sum back to the original exactly.
export fn split(m, n) {
    unless n > 0 { fail("cannot split into {n} parts") }
    allocate(m, map(range(0, n), fn(_) 1))
}

## Divide by ratio, in the currency's smallest unit, so nothing is lost.
##
## The remainder is handed out one minor unit at a time from the first share
## onward, rather than rounded away. Allocating $0.05 as 3:7 gives 0.02 and
## 0.03: the shares are as close to the ratio as whole cents allow, and they
## still sum to five cents.
##
## A negative amount allocates the same way with the sign carried through, so
## a refund splits like the charge it reverses.
export fn allocate(m, ratios) {
    unless len(ratios) > 0 { fail("allocate needs at least one ratio") }
    total_ratio = reduce(ratios, fn(acc, r) acc + r, 0)
    unless total_ratio > 0 { fail("allocate needs the ratios to sum above zero") }

    negative = m.amount < decimal(0)
    units = to_minor(abs_of(m))

    # Floor each share, then distribute what floor left behind.
    mut shares = []
    mut allocated = 0
    for r in ratios {
        share = units * r // total_ratio
        shares = push(shares, share)
        allocated = allocated + share
    }
    mut remainder = units - allocated
    mut i = 0
    while remainder > 0 {
        shares = set(shares, i, shares[i] + 1)
        remainder = remainder - 1
        i = (i + 1) % len(shares)
    }
    map(shares, fn(s) from_minor(if negative { 0 - s } else { s }, m.currency))
}

# --- rendering -----------------------------------------------------------------

## "10.50 USD", with the number of decimals the currency actually uses: yen
## render whole, dinar to three places.
export fn to_string(m) {
    # `fmt.fixed` renders the exact number of decimals the currency uses and
    # rounds in decimal, so yen come out whole and dinar to three places
    # without any digit work here.
    fmt.fixed(m.amount, minor_units(m.currency)) + " " + m.currency
}
