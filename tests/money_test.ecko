# Tests for the money package - offline, deterministic (no ai/fs/net).
#
# The cases that matter are the ones where naive arithmetic loses money:
# splitting an amount that does not divide evenly, and any use of floats. Every
# amount here is a Decimal, and every split is asserted to sum back exactly.
import std.test
import "../main.ecko"
m = main

# --- construction -------------------------------------------------------------

test.case("of and parse build the same amount", fn() {
    a = m.of(decimal("10.50"), "USD")
    b = m.parse("10.50", "USD")
    test.ok(m.eq(a, b), "same amount")
    test.eq(a.currency, "USD")
    test.eq(m.to_string(a), "10.50 USD")
})

test.case("an amount is stored exactly, not as a float", fn() {
    # 0.1 + 0.2 is the canonical float failure. On Decimal it is exactly 0.3.
    total = m.add(m.parse("0.10", "USD"), m.parse("0.20", "USD"))
    test.ok(m.eq(total, m.parse("0.30", "USD")), "0.10 + 0.20 == 0.30 exactly")
})

test.case("a currency code must be three letters", fn() {
    test.eq(try { m.parse("1.00", "usd!") } catch (e) { get(e, "kind") }, "money")
    test.eq(try { m.parse("1.00", "US") } catch (e) { get(e, "kind") }, "money")
    # Lowercase is normalised rather than rejected.
    test.eq(m.parse("1.00", "usd").currency, "USD")
})

# --- arithmetic ---------------------------------------------------------------

test.case("add, sub, mul and neg", fn() {
    a = m.parse("10.00", "USD")
    b = m.parse("2.50", "USD")
    test.eq(m.to_string(m.add(a, b)), "12.50 USD")
    test.eq(m.to_string(m.sub(a, b)), "7.50 USD")
    test.eq(m.to_string(m.mul(b, 3)), "7.50 USD")
    test.eq(m.to_string(m.neg(b)), "-2.50 USD")
    test.eq(m.to_string(m.abs_of(m.neg(b))), "2.50 USD")
})

test.case("mixing currencies is an error, not a silent conversion", fn() {
    a = m.parse("10.00", "USD")
    b = m.parse("10.00", "EUR")
    test.eq(try { m.add(a, b) } catch (e) { get(e, "kind") }, "money")
    test.eq(try { m.compare(a, b) } catch (e) { get(e, "kind") }, "money")
})

test.case("comparisons", fn() {
    a = m.parse("10.00", "USD")
    b = m.parse("2.50", "USD")
    test.ok(m.gt(a, b), "10 > 2.50")
    test.ok(m.lt(b, a), "2.50 < 10")
    test.ok(m.eq(a, m.parse("10.00", "USD")), "equal")
    test.ok(m.is_zero(m.parse("0.00", "USD")), "zero")
    test.ok(m.is_negative(m.neg(b)), "negative")
})

# --- minor units ---------------------------------------------------------------

test.case("minor units follow ISO 4217, not a blanket two", fn() {
    test.eq(m.minor_units("USD"), 2)
    test.eq(m.minor_units("EUR"), 2)
    test.eq(m.minor_units("JPY"), 0)
    test.eq(m.minor_units("KWD"), 3)
})

test.case("to_minor and from_minor round-trip", fn() {
    usd = m.parse("10.50", "USD")
    test.eq(m.to_minor(usd), 1050)
    test.ok(m.eq(m.from_minor(1050, "USD"), usd), "round-trip USD")
    jpy = m.parse("1050", "JPY")
    test.eq(m.to_minor(jpy), 1050)
    test.ok(m.eq(m.from_minor(1050, "JPY"), jpy), "round-trip JPY has no subunits")
    kwd = m.parse("1.234", "KWD")
    test.eq(m.to_minor(kwd), 1234)
})

test.case("to_string renders the currency's own number of decimals", fn() {
    test.eq(m.to_string(m.parse("1050", "JPY")), "1050 JPY")
    test.eq(m.to_string(m.parse("1.234", "KWD")), "1.234 KWD")
    test.eq(m.to_string(m.parse("5", "USD")), "5.00 USD")
})

# --- allocation ---------------------------------------------------------------

test.case("split divides evenly when it can", fn() {
    parts = m.split(m.parse("10.00", "USD"), 4)
    test.eq(map(parts, m.to_string), ["2.50 USD", "2.50 USD", "2.50 USD", "2.50 USD"])
})

test.case("split never loses or invents a cent", fn() {
    # 0.10 into 3 cannot divide evenly. The remainder must be handed out, not
    # rounded away: 0.04 + 0.03 + 0.03 = 0.10.
    parts = m.split(m.parse("0.10", "USD"), 3)
    test.eq(map(parts, m.to_string), ["0.04 USD", "0.03 USD", "0.03 USD"])
    test.ok(m.eq(m.sum(parts, "USD"), m.parse("0.10", "USD")), "sums back exactly")
})

test.case("allocate distributes by ratio, remainder first", fn() {
    # The textbook case: 5 cents split 3:7 is 2 and 3, not 1.5 and 3.5.
    parts = m.allocate(m.parse("0.05", "USD"), [3, 7])
    test.eq(map(parts, m.to_string), ["0.02 USD", "0.03 USD"])
    test.ok(m.eq(m.sum(parts, "USD"), m.parse("0.05", "USD")), "sums back exactly")
})

test.case("allocation sums back exactly across many awkward cases", fn() {
    for amount in ["0.01", "0.07", "1.00", "9.99", "100.03"] {
        for n in [2, 3, 6, 7] {
            total = m.parse(amount, "USD")
            parts = m.split(total, n)
            test.eq(len(parts), n)
            test.ok(m.eq(m.sum(parts, "USD"), total), "split {amount} by {n} sums back")
        }
    }
})

test.case("allocate handles a zero ratio and a zero amount", fn() {
    parts = m.allocate(m.parse("1.00", "USD"), [1, 0, 1])
    test.eq(map(parts, m.to_string), ["0.50 USD", "0.00 USD", "0.50 USD"])
    zero = m.allocate(m.parse("0.00", "USD"), [1, 1])
    test.ok(m.eq(m.sum(zero, "USD"), m.parse("0.00", "USD")), "zero stays zero")
})

test.case("splitting a negative amount still sums back", fn() {
    total = m.parse("-0.10", "USD")
    parts = m.split(total, 3)
    test.ok(m.eq(m.sum(parts, "USD"), total), "negative sums back exactly")
})

fn err_of(f) = try {
    f()
    null
} catch (e) { [get(e, "kind"), get(e, "reason")] }

fn message_of(f) = try {
    f()
    ""
} catch (e) { get(e, "message") }

test.case("invalid splits are a programmer mistake, refused at the call", fn() {
    one = m.parse("1.00", "USD")
    test.eq(err_of(fn() m.split(one, 0)), ["bug", "bad_argument"])
    test.eq(err_of(fn() m.split(one, 1.5)), ["bug", "bad_argument"])
    test.eq(err_of(fn() m.allocate(one, [])), ["bug", "bad_argument"])
    test.eq(err_of(fn() m.allocate(one, [0, 0])), ["bug", "bad_argument"])
    test.eq(err_of(fn() m.allocate(one, "12")), ["bug", "bad_argument"])
})

test.case("allocate refuses a negative ratio instead of inventing money", fn() {
    one = m.parse("1.00", "USD")
    test.eq(err_of(fn() m.allocate(one, [2, -1])), ["bug", "bad_argument"])
    msg = message_of(fn() m.allocate(one, [2, -1]))
    test.ok(contains(msg, "money.allocate"), "names the function: {msg}")
    test.ok(contains(msg, "[2, -1]"), "shows the ratios: {msg}")
})

test.case("allocate refuses a float ratio with a clear message", fn() {
    one = m.parse("1.00", "USD")
    test.eq(err_of(fn() m.allocate(one, [0.3, 0.7])), ["bug", "bad_argument"])
    test.ok(contains(message_of(fn() m.allocate(one, [0.3, 0.7])), "money.allocate"), "names it")
})

test.case("allocate takes Decimal ratios", fn() {
    parts = m.allocate(m.parse("1.00", "USD"), [0.3m, 0.7m])
    test.eq(map(parts, m.to_string), ["0.30 USD", "0.70 USD"])
    parts2 = m.allocate(m.parse("0.10", "USD"), [0.5m, 0.25m, 0.25m])
    test.eq(map(parts2, m.to_string), ["0.05 USD", "0.03 USD", "0.02 USD"])
})

test.case("allocate hands the remainder to the largest remainders", fn() {
    usd = fn(s) m.parse(s, "USD")
    test.eq(map(m.allocate(usd("59.97"), [3, 7]), m.to_string), ["17.99 USD", "41.98 USD"])
    test.eq(map(m.allocate(usd("0.03"), [1, 100]), m.to_string), ["0.00 USD", "0.03 USD"])
    test.eq(
        map(m.allocate(usd("0.05"), [0, 1, 1]), m.to_string),
        ["0.00 USD", "0.03 USD", "0.02 USD"],
    )
    # A negative amount allocates like its positive, sign carried through.
    test.eq(map(m.allocate(usd("-59.97"), [3, 7]), m.to_string), ["-17.99 USD", "-41.98 USD"])
})

test.case("a zero ratio never receives money", fn() {
    for amount in ["0.01", "0.05", "0.99", "10.07"] {
        parts = m.allocate(m.parse(amount, "USD"), [0, 1, 1, 0, 3])
        test.ok(m.is_zero(parts[0]), "{amount}: first zero share")
        test.ok(m.is_zero(parts[3]), "{amount}: fourth zero share")
        test.ok(m.eq(m.sum(parts, "USD"), m.parse(amount, "USD")), "{amount} sums back")
    }
})

test.case("split and allocate refuse an amount finer than the currency", fn() {
    fine = m.mul(m.parse("0.10", "USD"), decimal("0.333"))
    test.eq(err_of(fn() m.split(fine, 3)), ["money", "too_precise"])
    test.eq(
        err_of(fn() m.allocate(m.mul(m.parse("0.01", "USD"), 0.5m), [1, 1])),
        ["money", "too_precise"],
    )
    test.ok(contains(message_of(fn() m.split(fine, 3)), "rounding: true"), "says how to round")
})

test.case("an amount that is not one is refused, not computed on", fn() {
    usd = m.parse("1.00", "USD")
    test.eq(err_of(fn() m.add({ amount: 1, currency: "USD" }, usd)), ["bug", "bad_argument"])
    test.eq(err_of(fn() m.add(usd, 5)), ["bug", "bad_argument"])
    test.eq(err_of(fn() m.to_string(null)), ["bug", "bad_argument"])
    test.ok(contains(message_of(fn() m.add(usd, 5)), "money.add"), "names the function")
})

test.case("mul refuses a float factor with a clear message", fn() {
    usd = m.parse("1.00", "USD")
    test.eq(err_of(fn() m.mul(usd, 0.1)), ["bug", "bad_argument"])
    test.ok(contains(message_of(fn() m.mul(usd, 0.1)), "money.mul"), "names the function")
    test.eq(m.to_string(m.mul(usd, 0.1m)), "0.10 USD")
})

test.case("of refuses a float amount and from_minor a non-integer", fn() {
    test.eq(err_of(fn() m.of(0.1, "USD")), ["bug", "bad_argument"])
    test.eq(err_of(fn() m.from_minor(10.5, "USD")), ["bug", "bad_argument"])
    test.eq(err_of(fn() m.sum("abc", "USD")), ["bug", "bad_argument"])
})

test.case("errors carry a stable reason", fn() {
    usd = m.parse("1.00", "USD")
    test.eq(err_of(fn() m.parse("1.00", "US")), ["money", "bad_currency"])
    test.eq(err_of(fn() m.parse("1.00", "ABC")), ["money", "unknown_currency"])
    test.eq(err_of(fn() m.add(usd, m.parse("1.00", "EUR"))), ["money", "currency_mismatch"])
    test.eq(err_of(fn() m.parse("12.345", "USD")), ["money", "too_precise"])
    test.eq(err_of(fn() m.parse("abc", "USD")), ["money", "bad_amount"])
})

test.case("zero and normalize_code", fn() {
    test.eq(m.to_string(m.zero("jpy")), "0 JPY")
    test.ok(m.is_zero(m.zero("USD")), "zero is zero")
    test.eq(m.normalize_code("eur"), "EUR")
    test.eq(err_of(fn() m.normalize_code("EURO")), ["money", "bad_currency"])
    test.eq(get(m.minor_unit_table(), "KWD"), 3)
})

# --- sum ----------------------------------------------------------------------

test.case("sum adds a list, and needs a currency for the empty case", fn() {
    items = [m.parse("1.10", "USD"), m.parse("2.20", "USD"), m.parse("3.30", "USD")]
    test.eq(m.to_string(m.sum(items, "USD")), "6.60 USD")
    test.eq(m.to_string(m.sum([], "USD")), "0.00 USD")
})

# --- precision at the boundary ------------------------------------------------
#
# An amount enters the package through parse or of. One with more decimal places
# than its currency has used to be kept and rounded later, out of sight, the
# first time it was printed or converted: parse("12.345", "USD") read back as
# 12.35. That is refused now, and rounding is something you ask for.

test.case("parse refuses more decimal places than the currency has", fn() {
    test.eq(try { m.parse("12.345", "USD") } catch (e) { get(e, "kind") }, "money")
    test.eq(try { m.parse("12.5", "JPY") } catch (e) { get(e, "kind") }, "money")
    test.eq(try { m.of(decimal("12.345"), "USD") } catch (e) { get(e, "kind") }, "money")
    msg = try { m.parse("12.345", "USD") } catch (e) { get(e, "message") }
    test.ok(contains(msg, "USD"), "names the currency: {msg}")
    test.ok(contains(msg, "rounding"), "says how to round on purpose: {msg}")
})

test.case("parse rounds only when asked, half away from zero", fn() {
    test.eq(m.to_string(m.parse("12.345", "USD", rounding: true)), "12.35 USD")
    test.eq(m.to_string(m.parse("12.5", "JPY", rounding: true)), "13 JPY")
    test.eq(m.to_string(m.parse("-12.345", "USD", rounding: true)), "-12.35 USD")
})

test.case("an amount within the currency's precision is accepted", fn() {
    test.eq(m.to_string(m.parse("1.234", "KWD")), "1.234 KWD")
    test.eq(m.to_string(m.parse("10", "USD")), "10.00 USD")
    test.eq(m.to_string(m.parse("7", "JPY")), "7 JPY")
})

test.case("an unknown currency code is refused", fn() {
    test.eq(try { m.parse("1.00", "XXX") } catch (e) { get(e, "kind") }, "money")
    test.eq(try { m.parse("1.00", "ABC") } catch (e) { get(e, "kind") }, "money")
    test.eq(try { m.minor_units("ABC") } catch (e) { get(e, "kind") }, "money")
})

test.case("every ISO 4217 minor unit is known, not assumed to be two", fn() {
    test.eq(m.minor_units("CHF"), 2)
    test.eq(m.minor_units("CLF"), 4)
    test.eq(m.minor_units("UYW"), 4)
    test.eq(m.minor_units("UYI"), 0)
    test.eq(m.minor_units("clp"), 0)
})

test.case("arithmetic may carry extra precision; it is rounded on the way out", fn() {
    tax = m.mul(m.parse("10.00", "USD"), decimal("0.0825"))
    test.eq(m.to_string(tax), "0.83 USD")
})
